# Copy to `.env` to enable the optional "Live LLM" drafter.
# The app runs fully WITHOUT this — the deterministic drafter needs no key.
# Never commit your real .env (it is gitignored).

# Anthropic API key (client-side, local demo only — proxy this in production).
VITE_ANTHROPIC_API_KEY=

# Optional: override the model used for drafting.
# VITE_ANTHROPIC_MODEL=claude-sonnet-5
