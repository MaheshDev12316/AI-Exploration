# ---------------------------------------------------------------------------
# Salesforce connector configuration  (server/.env — never commit this file)
# ---------------------------------------------------------------------------
# The connector is a CONFIG-GATED OPTIONAL STRETCH. Use a PERSONAL Developer
# Edition org only — never a company, customer, or production org.
#
# With NO credentials set, the server runs in MOCK mode (fictional data), so
# the deal picker works offline. Fill these in to query your live Dev org.

PORT=8787

# Force a mode explicitly (optional): true = mock, false = live.
# If unset, the server is 'live' when SF_USERNAME + SF_PASSWORD are present.
# SF_MOCK=false

# --- Live org credentials ---
# LOGIN URL — pick the one that matches your org:
#   Developer Edition / production : https://login.salesforce.com
#   SANDBOX                        : https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com
# Note: sandbox usernames end with the sandbox name, e.g. you@acme.com.uat
SF_USERNAME=
SF_PASSWORD=
# Appended to the password. Reset under Setup → My Personal Information →
# Reset My Security Token (needed unless your IP is in a trusted range).
SF_SECURITY_TOKEN=

# --- Optional: connected app for the OAuth2 password grant ---
# If omitted, jsforce uses a SOAP login (fine for a Dev org).
SF_CLIENT_ID=
SF_CLIENT_SECRET=

SF_API_VERSION=60.0
